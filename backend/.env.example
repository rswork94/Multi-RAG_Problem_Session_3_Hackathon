# Copy to backend/.env. Without credentials the app runs in OFFLINE mode:
# regex graph extraction, extractive answers, lexical faithfulness judge, offline HyDE expansion.
ANTHROPIC_API_KEY=
# or use OpenRouter (models like anthropic/claude-opus-5.5). Keys can also be set in Tab 1 → Model settings.
OPENROUTER_API_KEY=

# Claude models (official anthropic SDK). Opus writes every final answer for all 3 engines (fair comparison);
# Haiku does HyDE passages, entity-relation extraction and the faithfulness judge.
SYNTH_MODEL=            # default: claude-opus-5-5 (Anthropic) / anthropic/claude-opus-5.5 (OpenRouter)
UTILITY_MODEL=          # default: claude-haiku-5-5 / anthropic/claude-haiku-5.5
SYNTH_EFFORT=medium

# Local models (pre-download with: .venv/bin/python scripts/setup_models.py)
EMBED_MODEL=BAAI/bge-large-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
DEVICE=auto            # auto | mps | cpu

# Guards
EXTRACTION_COST_LIMIT_USD=1.0   # LLM extraction above this estimate needs explicit confirmation
USE_LLM_SCOPE=0                 # 1 = Haiku scope/integrity classifier instead of the heuristic
DATA_DIR=./data
